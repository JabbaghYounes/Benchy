# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
venv-compile*/
.venv/
env/

# Hailo Dataflow Compiler / Model Zoo wheels — EULA-gated downloads
# from the Hailo Developer Zone, large (~500 MB each), and per-user
# entitlement. Each developer pulls their own copy into resources/hailo-sdk/
# and points the per-arch compile venv at it; never commit the wheels.
resources/hailo-sdk/*.whl

# Build artifacts
build/
dist/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Benchmark outputs (raw runs and generated reports)
results/*.json
results/*.csv
results/aggregated/
results/dashboard.html
results/report/
# Keep checked-in example results
!results/example_*.json
!results/example_*.csv

# Hailo conversion cache (also lives at ~/.cache/benchy/hailo/)
.cache/

# Hailo conversion intermediate artefacts (ONNX exports + per-model
# metadata). Auto-generated by benchmark/workloads/yolo/conversion/ on
# any --backend hailo run; not source.
models/

# HW-verify result bundles. The existing results/*.{json,csv} ignores
# only catch loose files; bundle directories produced by
# scripts/verify_ai_hat_plus*.sh need their own pattern.
results/hw_verify_*/

# Ultralytics auto-downloads PT weights to the cwd (repo root) on first
# use. Not source; safe to delete and re-download.
/yolo*.pt

# Setup-script + HailoRT runtime logs land at repo root. Runtime
# artefacts, not source. `hailort.log` in particular is recreated on
# every hailortcli invocation.
/*.log

# Internal PRDs and dev-phase scoping notes — kept locally only.
# documents/ holds the original Benchy / Hailo / Model Expansion PRDs and
# their task breakdowns; the matching PDFs live at the repo root. Neither
# is consumed by the runtime — `resources/` is the folder that ships with
# the product for setup scripts.
documents/
/Edge*.pdf

# Local editor / agent state — not part of the project.
.claude/
